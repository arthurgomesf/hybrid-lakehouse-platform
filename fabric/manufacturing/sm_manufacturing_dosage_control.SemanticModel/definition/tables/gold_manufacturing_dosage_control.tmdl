table gold_manufacturing_dosage_control
	sourceLineageTag: [dbo].[gold_manufacturing_dosage_control]

	measure 'Total Planned Resin Kg' =
			
			SUM(gold_manufacturing_dosage_control[planned_resin_total_kg])
		formatString: 0

		changedProperty = Name

	measure 'Orders Count' =
			
			DISTINCTCOUNT(gold_manufacturing_dosage_control[order_number])
		formatString: 0

		changedProperty = Name

	measure 'Total Actual Consumed Kg' =
			
			SUM(gold_manufacturing_dosage_control[actual_consumed_total_kg])

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Variance Kg' =
			
			SUM(gold_manufacturing_dosage_control[variance_kg])

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance Percent (weighted)' =
			
			-- soma das variacoes / soma do planejado; nunca AVERAGE(variance_percent)
			DIVIDE([Total Variance Kg], [Total Planned Resin Kg]) * 100
		formatString: 0.00

	column machine
		dataType: string
		sourceLineageTag: machine
		summarizeBy: none
		sourceColumn: machine

		annotation SummarizationSetBy = Automatic

